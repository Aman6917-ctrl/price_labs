# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=support_intelligence

# Anthropic Claude (chat LLM)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
# Other models available on this account include: claude-sonnet-4-6, claude-haiku-4-5-20251001, claude-opus-5
# Note: classic ids like claude-3-5-sonnet-latest may 404 depending on your Anthropic workspace.

# Local embeddings (no API key required)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Docs / knowledge base
DOCS_PATH=../docs

# RAG / Chroma (new collection name for MiniLM dimensions)
CHROMA_PERSIST_DIR=../vectorstore
CHROMA_COLLECTION=pricelabs_docs_minilm
RAG_TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
